{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/work/experience",
      "destination": "/work/experience/index.html"
    },
    {
      "source": "/work/skills-and-tools",
      "destination": "/work/skills-and-tools/index.html"
    },
    {
      "source": "/work/contact",
      "destination": "/work/contact/index.html"
    },
    {
      "source": "/((?!assets/|_next/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
